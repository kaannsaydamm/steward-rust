{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steward",
  "version": "0.1.0",
  "identifier": "io.steward.desktop",
  "build": {
    "frontendDist": "../../web-ui/out"
  },
  "app": {
    "windows": [
      {
        "title": "Steward",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "url": "http://127.0.0.1:3000/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}